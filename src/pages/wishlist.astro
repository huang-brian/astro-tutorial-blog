---
import BaseLayout from '../layouts/BaseLayout.astro';
import wishlist from '../data/wishlist.json';

const categories = [...new Set(wishlist.map((item) => item.category))];
---

<BaseLayout title="Wishlist" description="Climbing gear, books, shibari, and other items on my wishlist.">
  <style>
    .content {
      max-width: var(--max-width);
      margin: 0 auto;
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .category-section {
      margin-bottom: 3.5rem;
    }

    .category-section h2 {
      font-size: 1.1rem;
      font-weight: 500;
      text-transform: capitalize;
      letter-spacing: 0.055em;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 0.6rem;
      margin: 0.5rem 0 1.75rem;
    }

    .wishlist-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .wishlist-card {
      text-decoration: none;
      color: var(--text);
    }

    .wishlist-card.has-link:hover .wishlist-image img {
      filter: saturate(1.1);
      transition: filter 0.2s;
    }

    .wishlist-image {
      aspect-ratio: 1;
      overflow: hidden;
      background: var(--bg);
      margin-bottom: 0.75rem;
    }

    .wishlist-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .wishlist-card h3 {
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.3;
    }

    a.wishlist-card.book h3,
    div.wishlist-card.book h3 {
      font-style: italic;
      font-weight: 400;
      margin: 0.25rem 0;
    }

    .book-author {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-top: 0rem;
      font-style: normal;
    }

    .wishlist-card:not(.has-link) {
      cursor: default;
    }

    @media (max-width: 640px) {
      .wishlist-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
      }
    }

    @media (max-width: 420px) {
      .wishlist-grid {
        grid-template-columns: 1fr;
      }

      .wishlist-image {
        padding: 0 1.5rem;  /* Add horizontal padding around images on mobile */
      }
    }
  </style>

  <div class="content">
    {categories.map((category) => (
      <section class="category-section">
        <h2>{category}</h2>
        <div class="wishlist-grid">
          {wishlist
            .filter((item) => item.category === category)
            .map((item) => {
              const hasLink = Boolean(item.link);
              const isBook = category === 'Books';
              const Tag = hasLink ? 'a' : 'div';
              return (
                <Tag
                  class={`wishlist-card${hasLink ? ' has-link' : ''}${isBook ? ' book' : ''}`}
                  {...(hasLink ? { href: item.link, target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <div class="wishlist-image">
                    <img src={item.image} alt={item.title} />
                  </div>
                  <h3>{item.title}</h3>
                  {isBook && item.author && (
                    <div class="book-author">{item.author}</div>
                  )}
                </Tag>
              );
            })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

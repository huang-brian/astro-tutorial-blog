---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SiteTitle from '../components/SiteTitle.astro';
import wishlist from '../data/wishlist.json';

const categories = [...new Set(wishlist.map((item) => item.category))];
---

<BaseLayout title="Wishlist — Brian Below">
  <style>
    .site-header {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 2rem;
      padding: 3rem 0 0.5rem;
    }

    .nav-col {
      padding-top: 0.2rem;
    }

    .content {
      max-width: var(--max-width);
      margin: 0 auto;
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .category-section {
      margin-bottom: 3.5rem;
    }

    .category-section h2 {
      font-size: 1.1rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 0.6rem;
      margin-bottom: 1.75rem;
    }

    .wishlist-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .wishlist-card {
      text-decoration: none;
      color: var(--text);
    }

    .wishlist-card.has-link:hover .wishlist-image img {
      filter: saturate(1.1);
    }

    .wishlist-image {
      aspect-ratio: 1;
      overflow: hidden;
      background: var(--rule);
      margin-bottom: 0.75rem;
    }

    .wishlist-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.9);
      transition: filter 0.2s;
      display: block;
    }

    .wishlist-card h3 {
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.3;
    }

    .wishlist-card:not(.has-link) {
      cursor: default;
    }

    @media (max-width: 640px) {
      .site-header {
        grid-template-columns: 1fr;
        gap: 1.25rem;
        padding-top: 2rem;
      }

      .wishlist-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
      }
    }

    @media (max-width: 420px) {
      .wishlist-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <header class="site-header" style="padding-bottom: 1rem; border-bottom: 1px solid var(--rule);">
    <div class="nav-col">
      <Nav />
    </div>
    <SiteTitle />
  </header>

  <div class="content">
    {categories.map((category) => (
      <section class="category-section">
        <h2>{category}</h2>
        <div class="wishlist-grid">
          {wishlist
            .filter((item) => item.category === category)
            .map((item) => {
              const hasLink = Boolean(item.link);
              const Tag = hasLink ? 'a' : 'div';
              return (
                <Tag
                  class={`wishlist-card${hasLink ? ' has-link' : ''}`}
                  {...(hasLink ? { href: item.link, target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <div class="wishlist-image">
                    <Image
                      src={item.image}
                      alt={item.title}
                      inferSize
                      width={400}
                      height={400}
                      loading="lazy"
                    />
                  </div>
                  <h3>{item.title}</h3>
                </Tag>
              );
            })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
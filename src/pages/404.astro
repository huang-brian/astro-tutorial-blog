---
import BaseLayout from '../layouts/BaseLayout.astro';

// This page's header has no border-bottom, unlike every other page
// (BaseLayout's default). Uses headerClass to target just this page
// instead of duplicating the header markup.
---

<BaseLayout title="404 — Brian Below">
  <style>
    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 1em;
      margin: 2.5em;
    }

    h1 {
      font-size: 4.5rem;
      font-weight: 200;
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--text-muted);
      margin-block: 0;
    }
  </style>



  <div class="container">
    <h1>404.</h1>
    <p>Page not found.<br />
    This page doesn't exist yet :(</p>
  </div>
</BaseLayout>

---
// src/components/SiteTitle.astro
// Site name and tagline. Used on all pages except BlogPost.

import quotes from '../data/quotes.json';
// Pick one quote for initial load (fallback)
const initialQuote = quotes[Math.floor(Math.random() * quotes.length)];
---

<div class="site-title-block">
  <div class="site-title">Brian Below</div>
  <p class="tagline" id="tagline">{initialQuote}</p>
</div>

<script define:vars={{ quotes }}>
  // This runs in the browser and picks a new random quote
  const tagline = document.getElementById('tagline');
  const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
  tagline.textContent = randomQuote;
</script>

<style>
  .site-title-block .site-title {
    margin: 0;
    font-size: 3rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .site-title-block .tagline {
    font-size: 1rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .site-title-block .site-title { font-size: 2.2rem; }
  }
</style>
---
// src/layouts/BlogPost.astro
// Extends BaseLayout. Renders the nav, post header, optional hero, and prose body.

import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  date: Date;
  description?: string;
  heroImage?: string;
}

const { title, date, description, heroImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Brian Below`} description={description} showTitle={false}>

  <style>
    /* ── Post header ─────────────────────────────────────────── */
    .post-header {
      max-width: 70ch;
      margin: 0 auto;
      padding: 1.5rem 0 1.75rem;
    }

    .post-title {
      font-size: 2.2rem;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin-bottom: 0.6rem;
    }

    .post-date {
      font-size: 0.9rem;
      font-family: garamond-premier-pro-caption;
      color: var(--text-muted);
    }

    /* ── Hero image ──────────────────────────────────────────── */
    .hero {
      max-width: 70ch;
      margin: 0 auto 2rem;
    }

    .hero img {
      width: 100%;
      display: block;
    }

    /* ── Prose body container ───────────────────────────────────
       Typography rules (headings, links, lists, code, etc.) now
       live in ../styles/global.css so every markdown-rendering
       layout gets them consistently. Only the container box model
       stays here since it's specific to blog post width. */
    .prose {
      max-width: 70ch;
      margin: 0 auto;
      padding-bottom: 3rem;
    }

    .prose :global(img) {
      max-width: 100%;
      display: block;
      margin: 2em 0;
    }

    /* ── Mobile ──────────────────────────────────────────────── */
    @media (max-width: 640px) {
      .post-title   { font-size: 1.7rem; }
    }
  </style>

  <div class="post-header">
    <h1 class="post-title">{title}</h1>
    <p class="post-date">{formattedDate}</p>
  </div>

  {heroImage && (
    <div class="hero">
      <img src={heroImage} alt={title} />
    </div>
  )}

  <article class="prose">
    <slot />
  </article>

</BaseLayout>